# ──────────────────────────────────────────────────────
# PocketDesk PDF Processor — Environment Variables
# ──────────────────────────────────────────────────────

# Minimum stripped characters on a page for it to count as "native text".
# Pages below this threshold are sent to OCR.
# Default: 50
MIN_NATIVE_TEXT_CHARS=50

# DPI used to render pages for OCR.  200 is a good speed/accuracy balance.
# Increase to 300 if OCR accuracy is poor on your scanned documents.
# Default: 200
OCR_DPI=200

# Maximum upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# Server host and port
HOST=0.0.0.0
PORT=8000
