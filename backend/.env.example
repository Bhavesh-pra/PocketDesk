PORT=5000
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_TOKEN=your-shared-secret-here

JWT_SECRET=your-super-secret-jwt-key-min-32-chars

RESEND_API_KEY=re_your-resend-api-key

FRONTEND_URL=https://www.pocketdesk.in
CORS_ALLOWED_ORIGINS=https://pocketdesk.in,https://www.pocketdesk.in,http://localhost:5173,http://localhost:5174

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
